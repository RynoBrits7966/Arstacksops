# Copy to .env for local development. Do not commit .env.
# Railway: set these on the service. Do not put the allowlist in frontend code.

# Postgres connection string from the Railway Postgres plugin.
# Required in production. Local development can omit it and uses an in-memory store.
DATABASE_URL=

# Long random string. Required in production.
BETTER_AUTH_SECRET=

# Public origin of the app, with no trailing slash.
# Local dev stays on localhost. On Railway set:
# BETTER_AUTH_URL=https://arstacksops-production.up.railway.app
BETTER_AUTH_URL=http://localhost:5173

# Comma-separated emails allowed to register. Checked only on the server.
# Put the three team addresses in .env or in Railway. Do not put them in frontend code.
# An empty list rejects every sign-up.
SIGNUP_ALLOWLIST=

# Outgoing mail. Port 465 is implicit TLS. Certificate checks stay on.
# Set the mailbox address for SMTP_USER and SMTP_FROM on Railway.
# Put the mailbox password only in Railway. Do not commit it.
SMTP_HOST=mail.arstacks.co.za
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# EMAIL_DELIVERY=test is for local tests only. It stores messages in memory and must not be set on Railway.
# EMAIL_DELIVERY=
