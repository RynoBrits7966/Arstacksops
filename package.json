{
  "name": "arstacksops",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx --env-file=.env server/index.ts",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "start": "tsx server/index.ts",
    "provision": "tsx server/provision.ts",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "better-auth": "^1.7.7",
    "hono": "^4.13.13",
    "nodemailer": "^10.1.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
